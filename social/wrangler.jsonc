// Deployed by Cloudflare Workers Builds from the main branch (root directory: social). The ADMIN secret is set in
// Cloudflare only and is kept across deploys. Custom domain social.solvinglifewith.com is attached in Cloudflare.
{
  "name": "solvinglife-social",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "SL", "id": "b3fe465a03cb4f54913f133f24ef548d" }],
  "triggers": { "crons": ["17 6 * * 1", "21 9 * * *"] },
  "routes": [{ "pattern": "social.solvinglifewith.com", "custom_domain": true }]
}
